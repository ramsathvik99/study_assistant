# ── Frontend Environment Variables ─────────────────────────────────────────────
#
# Copy this file to .env.local for local development (git-ignored by default).
# For Vercel production, set these in:
#   Vercel Dashboard → Project → Settings → Environment Variables
#
# ── REQUIRED ────────────────────────────────────────────────────────────────────
#
# Full base URL of the backend API, including the /api suffix.
# Do NOT add a trailing slash.
#
# Local development:
VITE_API_BASE_URL=http://localhost:5000/api
#
# Production (set this in Vercel's dashboard, not here):
# VITE_API_BASE_URL=https://study-assistant-mg5l.onrender.com/api
