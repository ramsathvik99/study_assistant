# ── Backend Environment Variables ──────────────────────────────────────────────
#
# Copy this file to .env for local development (git-ignored).
# For Render production, set these in:
#   Render Dashboard → Service → Environment
#
# ── REQUIRED ────────────────────────────────────────────────────────────────────
#
# Port the Express server listens on.
# Render injects PORT automatically — do not override it in production.
PORT=5000

# OpenRouter configuration
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Comma-separated list of allowed frontend origins (no trailing slashes).
# All *.vercel.app domains are also allowed automatically.
# Local development:
FRONTEND_URL=http://localhost:5173,http://localhost:3000,http://localhost:5174
#
# Production (set this in Render's dashboard, not here):
# FRONTEND_URL=https://study-assistant-468n-murex.vercel.app
